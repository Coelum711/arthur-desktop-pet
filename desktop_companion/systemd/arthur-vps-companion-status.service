[Unit]
Description=Arthur read-only loopback companion status exporter
After=local-fs.target

[Service]
Type=simple
User=arthur-vps
Group=arthur-vps
WorkingDirectory=/opt/arthur-desktop-companion/runtime
Environment=PYTHONPATH=/opt/arthur-desktop-companion/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/arthur-desktop-companion/runtime/desktop_companion/server.py --config /etc/arthur-desktop-companion/config.vps.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
